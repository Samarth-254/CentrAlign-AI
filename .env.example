# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Ports & URLs
PORT_WEB=3000
PORT_AGENT=3001
WEB_BASE_URL=http://localhost:3000
AGENT_BASE_URL=http://localhost:3001

# Browser Settings
# HEADLESS=false runs headed Chromium to watch the agent work; set to true for headless
HEADLESS=true

# Credentials for Sandboxed Environments (never hardcoded in agent prompts)
PORTAL_USERNAME=ops@acme.test
PORTAL_PASSWORD=demo123
ERP_USERNAME=finance@acme.test
ERP_PASSWORD=books123

# Chaos Mode (false by default; true simulates 500 on first submit of new bill)
CHAOS_MODE=false
