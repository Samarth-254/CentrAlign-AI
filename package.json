{
  "name": "centralign-task-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @centralign/web --filter @centralign/agent dev",
    "dev:web": "pnpm --filter @centralign/web dev",
    "dev:agent": "pnpm --filter @centralign/agent dev",
    "build": "pnpm --filter @centralign/web build",
    "seed": "pnpm --filter @centralign/web seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "eval": "node evals/runner.js",
    "agent:run": "node apps/agent/src/cli.js"
  },
  "devDependencies": {
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "vitest": "^3.0.5"
  }
}
